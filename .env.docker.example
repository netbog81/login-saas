# ============================================================================
# Curandis Clinico — .env per docker compose
#
# Copia in `.env` e personalizza i valori. NON committare il `.env` reale.
# ============================================================================

# Environment Node
NODE_ENV=production

# ── OpenBao Agent (clinico) ─────────────────────────────────────────────────
# Endpoint dell'agent: dal container vediamo l'host via gateway 172.19.0.1
# del network evolution_net (allineato accounting). Porta 8203 = agent clinico.
OPENBAO_ADDR=http://172.19.0.1:8203
# GID del gruppo openbao-agent dell'host (per leggere il sink token).
# Ricavare con: getent group openbao-agent | cut -d: -f3
OPENBAO_AGENT_GID=986

# ── Keycloak OIDC ───────────────────────────────────────────────────────────
KEYCLOAK_URL=https://my.curandis.cloud
KEYCLOAK_REALM=curandis
KEYCLOAK_CLIENT_ID=curandis-app-angular

# ── Tenant Management System ────────────────────────────────────────────────
TMS_URL=https://api.curandis.cloud

# ── Curandis Registry ───────────────────────────────────────────────────────
REGISTRY_BASE_URL_PATTERN=https://registry.{tenant}.curandis.cloud/api/v1/registry
REGISTRY_DEFAULT_TENANT=bdq
REGISTRY_HTTP_TIMEOUT_MS=7000
REGISTRY_HTTP_RETRY_COUNT=2

# ── RabbitMQ (config statica, creds lette da OpenBao kv/clinico/rabbitmq) ──
RABBITMQ_ENABLED=true
RABBITMQ_REGISTRY_EXCHANGE=ex.registry.events
RABBITMQ_QUEUE_SUBJECTS=q.clinico.subjects
RABBITMQ_BINDING_PATTERN=subject.*.*
RABBITMQ_PREFETCH=10

# ── Port mapping host (allineato traefik esistente) ─────────────────────────
CLINICO_BACKEND_PORT=3000
CLINICO_FRONTEND_PORT=4200
