# ============================================================================
# Database
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=calendar_db

# Credenziali main DB usate dal pool dell'app (override OpenBao se manca).
MAIN_DB_USERNAME=postgres
MAIN_DB_PASSWORD=postgres

# ============================================================================
# Application
# ============================================================================
PORT=3000
NODE_ENV=development

# ============================================================================
# OpenBao (gestione credenziali dinamiche)
# ============================================================================
OPENBAO_AGENT_MODE=true
OPENBAO_ADDR=http://127.0.0.1:8200

# ============================================================================
# Keycloak (auth)
# ============================================================================
KEYCLOAK_URL=https://auth.curandis.cloud
KEYCLOAK_REALM=curandis
KEYCLOAK_CLIENT_ID=curandis-app-angular
# Credenziali admin (per provisioning tenant, opzionali in dev)
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Tenant di default per richieste senza subdomain (dev)
DEFAULT_TENANT=bdq

# ============================================================================
# Curandis Registry (anagrafica condivisa)
# Pattern URL: {tenant} viene sostituito con il tenantAlias estratto dal JWT/header.
# In dev locale puntare a http://localhost:3001/api/v1/registry.
# ============================================================================
REGISTRY_BASE_URL_PATTERN=https://registry.{tenant}.curandis.cloud/api/v1/registry
REGISTRY_DEFAULT_TENANT=bdq
REGISTRY_HTTP_TIMEOUT_MS=7000
REGISTRY_HTTP_RETRY_COUNT=2

# ============================================================================
# RabbitMQ (broker condiviso, eventi registry)
# Connection string standard di sviluppo (vedi /home/marco/curandis-registry/docs/integration-guide-clinico.md §4.2)
# ============================================================================
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://curandis-clinico-svc:clinico_dev_2024@localhost:5676/curandis
RABBITMQ_REGISTRY_EXCHANGE=ex.registry.events
RABBITMQ_QUEUE_SUBJECTS=q.clinico.subjects
# Pattern bind: subject.*.* cattura eventi di tutti i tenant.
# Per single-tenant usare es. subject.*.bdq.
RABBITMQ_BINDING_PATTERN=subject.*.*
RABBITMQ_PREFETCH=10

# ============================================================================
# WhatsApp gateway (opzionale)
# ============================================================================
WHATSAPP_ENCRYPTION_KEY=

# Tenant Management System (provisioning multi-tenant)
TMS_URL=
