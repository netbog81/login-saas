# ============================================================================
# Application
# ============================================================================
PORT=3000
NODE_ENV=development

# ============================================================================
# OpenBao Agent
# Le credenziali DB tenant + RabbitMQ + Keycloak admin/service-account sono
# tutte in OpenBao. Path documentati in docs/openbao-paths.md.
#   - kv/tenant-clinico-db/<alias>           DB-per-tenant info
#   - database/static-creds/postgres-clinico_<alias>_svc   credenziali rotated 24h
#   - kv/clinico/rabbitmq                    broker credentials
#   - kv/keycloak/service-account            admin client per provisioning
#   - kv/keycloak/clinico-service            service-account S2S verso registry
#   - kv/whatsapp/<tenantApiId>/encryption_key   chiave Whatsapp per-tenant
# ============================================================================
OPENBAO_AGENT_MODE=true
# In dev locale (host): http://127.0.0.1:8203 (agent clinico)
# In container: http://172.19.0.1:8203 (host via gateway)
OPENBAO_ADDR=http://127.0.0.1:8203
OPENBAO_AGENT_TOKEN_PATH=/run/openbao-agent-clinico/clinico-token

# ============================================================================
# Keycloak OIDC (frontend + JWKS verification)
# ============================================================================
KEYCLOAK_URL=https://my.curandis.cloud
KEYCLOAK_REALM=curandis
KEYCLOAK_CLIENT_ID=curandis-app-angular

# Tenant di default per richieste senza subdomain (dev)
DEFAULT_TENANT=bdq

# ============================================================================
# Tenant Management System (provisioning multi-tenant)
# ============================================================================
TMS_URL=https://api.curandis.cloud

# ============================================================================
# Curandis Registry (anagrafica condivisa)
# Pattern URL: {tenant} viene sostituito con il tenantAlias estratto dal JWT/header.
# ============================================================================
REGISTRY_BASE_URL_PATTERN=https://registry.{tenant}.curandis.cloud/api/v1/registry
REGISTRY_DEFAULT_TENANT=bdq
REGISTRY_HTTP_TIMEOUT_MS=7000
REGISTRY_HTTP_RETRY_COUNT=2

# ============================================================================
# RabbitMQ (broker condiviso)
# Le credenziali sono lette da OpenBao kv/clinico/rabbitmq in bootstrap.
# Queste variabili sono SOLO config statica (exchange, queue, binding).
# ============================================================================
RABBITMQ_ENABLED=true
RABBITMQ_REGISTRY_EXCHANGE=ex.registry.events
RABBITMQ_QUEUE_SUBJECTS=q.clinico.subjects
# Pattern bind: subject.# cattura gli eventi subject di tutti i tenant.
# Serve `#` e non `*.*`: la routing key è <eventType>.<tenantAlias> e gli
# eventType con un punto dentro (subject.role.added) fanno quattro segmenti,
# che `*.*` non accetta. Le virgolette sono obbligatorie: dotenv tronca il
# valore sul `#` se non è quotato.
RABBITMQ_BINDING_PATTERN="subject.#"
RABBITMQ_PREFETCH=10
