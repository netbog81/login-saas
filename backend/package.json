{
  "name": "calendar-backend",
  "version": "1.0.0",
  "description": "Backend NestJS per calendario multiutente",
  "scripts": {
    "build": "nest build",
    "check:entities": "ts-node scripts/check-entities-registered.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "schema:sync": "docker cp curandis-clinico-backend:/tmp/schema.gql src/schema.gql && echo \"schema.gql allineato al backend in esecuzione\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typeorm": "typeorm-ts-node-commonjs -d src/typeorm.config.ts",
    "migration:show": "npm run typeorm -- migration:show",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert"
  },
  "dependencies": {
    "@apollo/server": "^4.12.2",
    "@curandis/auth-core": "^1.3.1",
    "@curandis/encryption-core": "^1.2.0",
    "@curandis/openbao-core": "^1.2.0",
    "@curandis/storage-core": "^1.1.0",
    "@curandis/tenant-datasource": "^1.3.0",
    "@nestjs/apollo": "^12.2.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/graphql": "^12.2.2",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/typeorm": "^10.0.1",
    "amqp-connection-manager": "^4.1.15",
    "amqplib": "^0.10.9",
    "axios": "^1.13.5",
    "busboy": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.7",
    "dataloader": "^2.2.3",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.3.1",
    "eventemitter2": "^6.4.9",
    "graphql": "^16.12.0",
    "graphql-scalars": "^1.25.0",
    "graphql-type-json": "^0.3.2",
    "jose": "^6.1.3",
    "node-vault": "^0.10.9",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.19",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@types/amqplib": "^0.10.8",
    "@types/busboy": "^1.5.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
